# Supabase (project: podcast-studio / yvgxfvezqhcjftnvydko)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret — service role bypasses RLS (paste from Supabase dashboard: Settings > API)
SUPABASE_SERVICE_ROLE_KEY=
# OpenAI
OPENAI_API_KEY=
# Single-channel app default
NEXT_PUBLIC_DEFAULT_CHANNEL_ID=
# Canva Connect (OAuth) — cover template sync
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:3000/api/auth/canva/callback
# Google OAuth (YouTube upload + analytics)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
# Cloudflare R2 (video storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=podcast-studio
